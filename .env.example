# ============================================================
# MedIntel Environment Template
# NEVER put real production secrets in this file.
# Copy this file to .env for local development.
# ============================================================

# PostgreSQL
POSTGRES_DB=medintel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret

# Authentication
JWT_SECRET=YOUR_GENERATED_SECRET_HERE

# ------------------------------------------------------------
# Phase 3.8 - Clinical Reasoning
# ------------------------------------------------------------

# Keep disabled until a MedGemma endpoint has been configured.
AI_REASONING_ENABLED=false

AI_PROVIDER=local
PRIMARY_REASONING_MODEL=google/medgemma-1.5-4b-it
LOCAL_MEDGEMMA_MODEL_ID=google/medgemma-1.5-4b-it
MEDGEMMA_DEVICE=auto



# Provider behaviour
MEDGEMMA_TIMEOUT_SECONDS=120
MEDGEMMA_MAX_RETRIES=1

# Prompt / orchestration
REASONING_PROMPT_VERSION=clinical_reasoning_v1
REASONING_MAX_CANDIDATES=5

# Do not commit a real key.
